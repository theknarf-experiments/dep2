// Every function definition across languages: (file, name). The adapters
// recognise Rust function_items and the three JS/TS function forms.
//
//   dep2 run examples/functions.dl

.import "lang/ast.dl"
.import "lang/common.dl"
.import "lang/rust.dl"
.import "lang/javascript.dl"
.import "lang/spans.dl"

.out
.decl fn_def(file: string, name: string, line: number)

.rule
fn_def(File, Name, Line) :- fn_at(File, Name, Line).
