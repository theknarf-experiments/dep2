// Equality saturation with TERM-CREATING rewrites — and retraction.
//
// congruence.dl works over a fixed term universe: rules may assert equations
// between terms that already exist, but cannot invent new ones. That is enough
// for unification analyses (steensgaard.dl) and not enough for optimization,
// where the whole point of a rewrite is to produce a form that was not there.
//
// The missing piece was a way to MINT a term id. Here ids are structural
// strings built with `concat`, so the id of a term IS its syntax: the rewrite
// `X * 2 = X << 1` constructs `shl(a,1)` by name. No hashing, so no collisions
// — two terms share an id exactly when they are the same term. This needs
// `merge(min)` over a string column, which orders by decoded TEXT rather than
// by interned id, so the representative is stable across runs and workers.
//
// The rules below are the classic strength-reduction pair:
//
//   R1   X * 2      =  X << 1     creates the shl term
//   R2   (X << 1)/2 =  X          fires only via e-matching modulo equality
//
// R2 is the interesting one. Nothing in the input contains `(X << 1) / 2`; the
// division's child is `mul(a,2)`. R2 matches because it looks for a `shl` node
// in the DIVIDEND'S CLASS rather than at the dividend itself — which is exactly
// what e-matching modulo equality means, and it falls out of joining through
// `leader`.
//
// Retraction still works: delete the input expression and the derived equality
// goes with it, created terms included.
//
//   dep2 run examples/egraph/saturation.dl --source 'input_node=csv:path=expr.csv'
//
// "_" is the "no child" sentinel. LEAVES ARE NULLARY SYMBOLS NAMED AFTER
// THEMSELVES — `2` is `node("2", "2", "_", "_")`, not `node("2", "lit", ...)`.
// Congruence merges nodes sharing an operator and children, so giving every
// literal the operator "lit" would prove 1 = 2.

.in
// The starting expression, one row per e-node, ids already structural.
.decl input_node(t: string, op: string, a: string, b: string)

.printsize
.decl node(t: string, op: string, a: string, b: string)
.decl term(t: string)
.decl eq_input(x: string, y: string)
.decl eq_edge(x: string, y: string)
.decl cnode(t: string, op: string, la: string, lb: string)
.decl form_rep(op: string, la: string, lb: string, rep: string) merge(min)
.decl depth(t: string, d: number) merge(max)

.out
.decl leader(t: string, rep: string) merge(min)
// Everything proved equal, one row per unordered pair.
.decl proved_equal(a: string, b: string) order_by(a, b)

.rule
node(T, Op, A, B) :- input_node(T, Op, A, B).

// ---------- term depth, and why it is the thing to bound ----------
// A max-fold over the children. Structural ids make creation IDEMPOTENT —
// building `shl(a,1)` twice yields the same id — so the classic blowups do not
// actually diverge here: commutativity re-creates a term that already exists
// and the fixpoint closes. What does diverge is a rule that makes terms DEEPER
// without limit (`X = add(X, 0)` and friends), so depth is the quantity worth
// guarding.
depth(T, 0) :- node(T, _, "_", "_").
depth(T, D + 1) :- node(T, _, A, _), A != "_", depth(A, D).
depth(T, D + 1) :- node(T, _, _, B), B != "_", depth(B, D).

// ---------- rewrite rules ----------
// R1: X * 2 = X << 1. The head CONSTRUCTS a term id, which is the thing plain
// Datalog cannot do and the reason ids are strings here.
//
// The `depth < 8` guard is the general control rather than a need of this rule:
// `shl(X,1)` sits at the same depth as the `mul(X,2)` it replaces, so R1 cannot
// run away. A rule that does grow depth needs exactly this guard, and the bound
// also caps id LENGTH, which matters because a structural id cannot share a
// subterm the way a DAG does — see the header.
node(concat(concat("shl(", X), ",1)"), "shl", X, "1") :-
    node(_, "mul", X, "2"), depth(X, D), D < 8.
eq_input(T, concat(concat("shl(", X), ",1)")) :-
    node(T, "mul", X, "2"), depth(X, D), D < 8.

// R2: (X << 1) / 2 = X. Matched MODULO EQUALITY — `S` is any shl node sharing a
// class with the dividend, not necessarily the dividend itself.
eq_input(T, X) :-
    node(T, "div", C, "2"),
    leader(C, LC),
    leader(S, LC),
    node(S, "shl", X, "1").

// ---------- the factored e-graph (see congruence.dl) ----------
term(T) :- node(T, _, _, _).
term(A) :- node(_, _, A, _).
term(B) :- node(_, _, _, B).
term(X) :- eq_input(X, _).
term(Y) :- eq_input(_, Y).

eq_edge(X, Y) :- eq_input(X, Y).
eq_edge(Y, X) :- eq_input(X, Y).

cnode(T, Op, LA, LB) :- node(T, Op, A, B), leader(A, LA), leader(B, LB).
form_rep(Op, LA, LB, T) :- cnode(T, Op, LA, LB).
eq_edge(T, R) :- cnode(T, Op, LA, LB), form_rep(Op, LA, LB, R).
eq_edge(R, T) :- cnode(T, Op, LA, LB), form_rep(Op, LA, LB, R).

leader(T, T) :- term(T).
leader(X, L) :- eq_edge(X, Y), leader(Y, L).
leader(X, L) :- leader(X, M), leader(M, L).

// ---------- read off the equalities ----------
proved_equal(A, B) :- leader(A, L), leader(B, L), str_before(A, B) = 1.
