// Live import/dependency graph for the web visualizer (`mise run graph`).
//
// Modules come from project manifests, never from path heuristics or build
// files:
//   - JS/TS:  each package.json's "name" is a module; its directory is the root.
//   - Rust:   each Cargo.toml's [package] name is a module; its dir is the root.
//   - Python: each pyproject.toml's [project] name, same shape.
// A file belongs to the module whose manifest directory is a prefix of its path.
// A workspace node (when there are several modules) links them together.
// Go/Java/Kotlin have no per-module manifest we read (go.mod is not TOML and has
// no grammar; there are no build.gradle files), so they contribute NO module —
// their files take modules.dl's first-path-segment fallback and all of their
// value is in file_link. That is the honest cost of staying manifests-only.
//
// FILE links are per-language and each language module derives them itself:
//   - Rust/JS/TS: relative + alias paths, resolved in linking.dl.
//   - Python:     dotted module -> slash path, matched as a path suffix.
//   - Go:         import path -> the package DIRECTORY it ends with (all files).
//   - Java/Kotlin: declared package + declared symbol, shared through jvm.dl —
//                  which is why Kotlin -> Java edges come for free.
//   - Jsonnet:    import/importstr string, directory-relative, exact match
//                 (no bare-specifier concept — a dotless string is still
//                 relative to the importing file's directory).
//   - Terraform:  a `module` block's local source directory -> every `.tf`
//                 file directly in it (exact dir match, no manifest).
//
//   mise run graph .
//   mise run graph ~/some/monorepo
//
// The implementation lives in import_graph/ (one file per concern); this
// entry declares the graph's PUBLIC surface — the `.out` relations the web
// UI reads.

.import "import_graph/ast.dl"
.import "import_graph/modules.dl"
.import "import_graph/rust.dl"
.import "import_graph/javascript.dl"
.import "import_graph/python.dl"
.import "import_graph/go.dl"
// jvm.dl declares the four relations java.dl and kotlin.dl both derive into, so
// it has to be in the program for either of them to load.
.import "import_graph/jvm.dl"
.import "import_graph/java.dl"
.import "import_graph/kotlin.dl"
.import "import_graph/jsonnet.dl"
.import "import_graph/terraform.dl"
.import "import_graph/linking.dl"
.import "import_graph/analysis.dl"

.out
.decl module_node(name: string)
.decl module_edge(from: string, to: string)
.decl module_edge_pinned(from: string, to: string)
.decl module_edge_live(from: string, to: string)
.decl workspace_node(name: string)
.decl workspace_link(ws: string, module: string)
.decl file_node(file: string, module: string)
.decl file_link(src: string, dst: string)
.decl unused_dep(module: string, dep: string)
.decl undeclared_use(module: string, dep: string)
.decl module_cycle(a: string, b: string)
.decl file_cycle(a: string, b: string)
.decl test_file(file: string)
.decl cycle_file(file: string)
.decl cycle_module(module: string)
