// Barrel piercing: where does an imported symbol ACTUALLY come from?
//
// `import_graph.dl` already draws the file->file edge for a re-export, because
// `export ... from "spec"` is collected as an import. What it cannot tell you is
// that importing `Button` from a barrel is really a dependency on
// `components/Button/Button.tsx` — the barrel is a forwarding address, and every
// consumer appears to depend on it rather than on the thing they use.
//
// nettbil has 145 `export * from` and 86 named re-exports, all with relative
// specifiers, and the barrels chain: react-design-system/src/index.ts forwards
// to ./components, which is itself a barrel.
//
// The chain is DIRECTED — F re-exports from D, never the reverse — so symbol
// provenance is plain reachability rather than an equivalence, and three
// recursive rules compute it. `reexport_cycle` below checks the one condition
// that would change that: a cycle makes the relation genuinely symmetric and
// leaves reachability with no single origin to report. On nettbil it is empty.
//
// Measured on nettbil (~7.4k file links): 272 specifiers resolved with no
// ambiguity, 581 forwarded symbols, and 1,190 HIDDEN DEPENDENCIES — real
// file-to-file dependencies the import graph does not draw, because every
// consumer of a barrel appears to depend on the barrel. That is roughly 16% more
// edges than the graph has today. Five sampled results were checked by hand
// against the source and all five were right.
//
//   mise run graph ~/projects/nettbil/nettbil     # with GRAPH_PROGRAM set
//   dep2 run examples/reexports.dl --source 'treesitter:root=PROJECT;grammars=...'

.import "import_graph.dl"

.printsize
.decl reexport_star(file: string, spec: string)
.decl reexport_named(file: string, exported: string, source: string, spec: string)
.decl es_of(file: string, spec_node: string, stmt: string)
.decl es_ident(file: string, spec_node: string, idx: number, name: string)
.decl es_aliased(file: string, spec_node: string)
.decl stmt_spec(file: string, stmt: string, spec: string)
.decl has_from(file: string, stmt: string)
.decl default_stmt(file: string, stmt: string)
.decl rx_dir(file: string, dir: string)
.decl rx_cand(file: string, spec: string, path: string)
.decl ni_of(file: string, spec_node: string, stmt: string)
.decl ni_ident(file: string, spec_node: string, idx: number, name: string)
.decl ni_aliased(file: string, spec_node: string)
.decl js_named_import(file: string, name: string)

.out
// A specifier resolved to a real file in the graph.
.decl rx_target(file: string, spec: string, dst: string) order_by(file, spec)
// Names a file exports under its own steam (not forwarded).
.decl local_export(file: string, name: string)
// Every name a file offers, forwarded ones included.
.decl exports(file: string, name: string)
// Where a name a file offers is actually defined.
.decl origin(file: string, name: string, definer: string)
// The payoff: a file offers this name but did not define it — following the
// barrel gives the real dependency.
.decl forwarded(barrel: string, name: string, definer: string) order_by(barrel, name)
// Barrels ranked by how much they forward.
.decl barrel_size(barrel: string, forwards: number) order_by(forwards desc, barrel) limit(30)
// An import that lands on a barrel: the importer names a symbol the barrel only
// forwards, so the real dependency is on `definer`.
.decl imports_forwarded(importer: string, name: string, barrel: string, definer: string)
// The payoff. A real dependency the file graph does not draw, because every
// consumer of a barrel appears to depend on the barrel.
.decl hidden_dep(importer: string, definer: string) order_by(importer, definer)
.decl hidden_dep_count(importer: string, n: number) order_by(n desc, importer) limit(20)
// Would a directed reading be wrong? Non-empty means re-exports form a cycle.
.decl reexport_edge(from: string, to: string)
.decl reexport_reach(from: string, to: string)
.decl reexport_cycle(a: string, b: string)

.rule
// ---------- extraction ----------
// `export * from "spec"`: the statement carries an anonymous `*` child.
stmt_spec(F, Exp, Spec) :-
    ast_node(F, Exp, _, "export_statement", _, _),
    ast_node(F, Str, Exp, "string", _, _),
    ast_node(F, _, Str, "string_fragment", _, Spec).
has_from(F, Exp) :- stmt_spec(F, Exp, _).

reexport_star(F, Spec) :-
    stmt_spec(F, Exp, Spec),
    ast_node(F, _, Exp, "*", _, _).

// `export { A, B as C } from "spec"`: export_statement -> export_clause ->
// export_specifier. One identifier means no rename; two means `source as
// exported`, ordered by child index.
es_of(F, Sp, Exp) :-
    ast_node(F, Sp, Cl, "export_specifier", _, _),
    ast_node(F, Cl, Exp, "export_clause", _, _).
es_ident(F, Sp, I, N) :-
    es_of(F, Sp, _),
    ast_node(F, Id, Sp, "identifier", _, N),
    ast_child(F, Id, I).
es_aliased(F, Sp) :- es_ident(F, Sp, I1, _), es_ident(F, Sp, I2, _), I1 < I2.

reexport_named(F, E, S, Spec) :-
    es_ident(F, Sp, I1, S), es_ident(F, Sp, I2, E), I1 < I2,
    es_of(F, Sp, Exp), stmt_spec(F, Exp, Spec).
reexport_named(F, N, N, Spec) :-
    es_ident(F, Sp, _, N), !es_aliased(F, Sp),
    es_of(F, Sp, Exp), stmt_spec(F, Exp, Spec).

// ---------- resolve the specifier to a file ----------
// Every re-export specifier in this corpus is `./x` (no `../`), so the base is
// the file's own directory. Candidates: the path itself, with an extension, or
// as a directory with an index file.
rx_dir(F, before_last(F, "/")) :- graph_file(F), contains(F, "/") = 1.
rx_cand(F, S, concat(concat(D, "/"), after_last(S, "./"))) :-
    reexport_star(F, S), rx_dir(F, D), starts_with(S, "./") = 1.
rx_cand(F, S, concat(concat(D, "/"), after_last(S, "./"))) :-
    reexport_named(F, _, _, S), rx_dir(F, D), starts_with(S, "./") = 1.

rx_target(F, S, P) :- rx_cand(F, S, P), graph_file(P).
rx_target(F, S, Dst) :-
    rx_cand(F, S, P), graph_file(Dst), before_last(Dst, ".") = P.
rx_target(F, S, Dst) :-
    rx_cand(F, S, P), graph_file(Dst),
    before_last(Dst, "/") = P,
    before_last(after_last(Dst, "/"), ".") = "index".

// ---------- what each file offers ----------
// A definition exported in place: `export const/function/class/interface/type X`.
local_export(F, N) :-
    ast_node(F, Exp, _, "export_statement", _, _), !has_from(F, Exp), !default_stmt(F, Exp),
    ast_node(F, D, Exp, "lexical_declaration", _, _),
    ast_node(F, VD, D, "variable_declarator", _, _),
    ast_node(F, _, VD, "identifier", _, N).
local_export(F, N) :-
    ast_node(F, Exp, _, "export_statement", _, _), !has_from(F, Exp), !default_stmt(F, Exp),
    ast_node(F, D, Exp, "function_declaration", _, _),
    ast_node(F, _, D, "identifier", _, N).
local_export(F, N) :-
    ast_node(F, Exp, _, "export_statement", _, _), !has_from(F, Exp), !default_stmt(F, Exp),
    ast_node(F, D, Exp, "class_declaration", _, _),
    ast_node(F, _, D, "type_identifier", _, N).
local_export(F, N) :-
    ast_node(F, Exp, _, "export_statement", _, _), !has_from(F, Exp), !default_stmt(F, Exp),
    ast_node(F, D, Exp, "interface_declaration", _, _),
    ast_node(F, _, D, "type_identifier", _, N).
local_export(F, N) :-
    ast_node(F, Exp, _, "export_statement", _, _), !has_from(F, Exp), !default_stmt(F, Exp),
    ast_node(F, D, Exp, "type_alias_declaration", _, _),
    ast_node(F, _, D, "type_identifier", _, N).

// `export default ...` offers the name `default`, and does NOT offer the
// declaration's own name — `export default function Widget(){}` cannot be
// imported as `Widget`. The re-export side already works: in
// `export { default as Alert } from './x'` tree-sitter makes `default` an
// ordinary identifier, so the aliased rule above picks it up.
default_stmt(F, Exp) :-
    ast_node(F, Exp, _, "export_statement", _, _),
    ast_node(F, _, Exp, "default", _, _).
local_export(F, "default") :- default_stmt(F, Exp), !has_from(F, Exp).

exports(F, N) :- local_export(F, N).
exports(F, N) :- reexport_star(F, S), rx_target(F, S, D), exports(D, N).
exports(F, E) :- reexport_named(F, E, Src, S), rx_target(F, S, D), exports(D, Src).

// ---------- provenance ----------
origin(F, N, F) :- local_export(F, N).
origin(F, N, Def) :- reexport_star(F, S), rx_target(F, S, D), origin(D, N, Def).
origin(F, E, Def) :- reexport_named(F, E, Src, S), rx_target(F, S, D), origin(D, Src, Def).

forwarded(F, N, Def) :- origin(F, N, Def), F != Def.
barrel_size(F, count(N)) :- forwarded(F, N, _).

// ---------- the import side ----------
// `import { A, B as C } from "spec"` — the SOURCE name is what the exporter
// must offer, so for a rename take the identifier at the lower child index.
ni_of(F, Sp, Imp) :-
    ast_node(F, Sp, NI, "import_specifier", _, _),
    ast_node(F, NI, Cl, "named_imports", _, _),
    ast_node(F, Cl, Imp, "import_clause", _, _).
ni_ident(F, Sp, I, N) :-
    ni_of(F, Sp, _),
    ast_node(F, Id, Sp, "identifier", _, N),
    ast_child(F, Id, I).
ni_aliased(F, Sp) :- ni_ident(F, Sp, I1, _), ni_ident(F, Sp, I2, _), I1 < I2.
js_named_import(F, S) :- ni_ident(F, Sp, I1, S), ni_ident(F, Sp, I2, _), I1 < I2.
js_named_import(F, N) :- ni_ident(F, Sp, _, N), !ni_aliased(F, Sp).

// Which barrel the name came through is taken from the file graph rather than
// re-resolved: import_graph already links the importer to every file it
// imports, aliased and bare specifiers included. Joining on the NAME is what
// makes this specific — a barrel only counts if it actually forwards that name.
imports_forwarded(F, N, B, D) :-
    js_named_import(F, N), file_link(F, B), forwarded(B, N, D), F != D.
hidden_dep(F, D) :- imports_forwarded(F, _, _, D), !file_link(F, D).
hidden_dep_count(F, count(D)) :- hidden_dep(F, D).

// ---------- is the directed reading safe? ----------
reexport_edge(F, D) :- reexport_star(F, S), rx_target(F, S, D).
reexport_edge(F, D) :- reexport_named(F, _, _, S), rx_target(F, S, D).
reexport_reach(A, B) :- reexport_edge(A, B).
reexport_reach(A, C) :- reexport_reach(A, B), reexport_edge(B, C).
reexport_cycle(A, B) :- reexport_reach(A, B), reexport_reach(B, A).
